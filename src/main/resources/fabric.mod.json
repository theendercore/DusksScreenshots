{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [ "${authors}" ],
  "entrypoints": {
  },
  "mixins": [
    {
      "config": "dusks_screenshots.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "java": ">=${java}",
    "minecraft": "${version_range}",
    "fabricloader": "*",
    "fabric-api": "*"
  },
  "contact": {
    "homepage": "https://github.com/${github_repo}",
    "issues": "https://github.com/${github_repo}/issues",
    "sources": "https://github.com/${github_repo}",
    "discord": "${discord_invite}"
  },
  "license": "${license}",
  "icon": "assets/template/icon.png"
}